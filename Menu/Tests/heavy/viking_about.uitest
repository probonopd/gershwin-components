#!/usr/bin/env run_uitest
# GTK menu actions through Menu.app's global menu, verified for a relaunch.
# Launches viking (a GTK app with no DriveUI socket), activates its window,
# triggers Help -> About via the GLOBAL menu and waits for the About dialog.
# The enclosing test harness kills and relaunches viking between runs; the
# action must reach the LIVE app instance every time (a stale menu bound to a
# dead process would silently do nothing and this wait would time out).
#
# Run with: run_uitest Menu/Tests/heavy/viking_about.uitest
launch application "viking"
wait until xwindow "Viking"
activate xwindow "Viking"
select global menu "Hilfe/Über"
wait until xwindow "Info zu Viking"
log "viking about opened via global menu"
