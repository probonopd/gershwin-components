#!/usr/bin/env run_uitest
# Screenshot: the screenshot utility must start, show its window and its
# capture controls, then quit with the standard Cmd+Q shortcut.  The app is
# not activated, so no screenshot is taken.
#
# Leaves the computer as it was found: the app is quit at the end.
#
# Run with: run_uitest Screenshot/Tests/screenshot.uitest
launch application "Screenshot"
wait until window "Screenshot" timeout 5s
assert window "Screenshot"
assert text contains "Ready to take screenshot"
assert button "Window"
assert button "Full Screen"
assert menu item "Screenshot/Quit" shortcut "Cmd+Q"
press "Cmd+Q"
wait until not exists window "Screenshot" timeout 5s
log "Screenshot starts, shows its controls and quits"
