#!/bin/sh
#
# make_appimage - Package a GNUstep application into an AppImage.
#
# Usage:
#   make_appimage [options] <app-name>
#
# Options:
#   -o <file>     Output AppImage filename (default: <app>-<version>-<arch>-<os>.AppImage)
#   -d <dir>      Working directory for AppDir build (default: /tmp/appimage-<app>)
#   -c <comment>  Comment for .desktop file
#   -C <cat>      Categories for .desktop file (e.g. "Utility;")
#   -e <path>     Path to main executable relative to AppDir (auto-detected if omitted)
#   -t <tool>     Path to appimagetool (default: appimagetool in PATH)
#   -h            Show this help

set -e

APPIMAGE_TOOL="${APPIMAGE_TOOL:-appimagetool}"
OUTPUT_FILE=""
BUILD_DIR=""
COMMENT=""
CATEGORIES=""
MAIN_EXEC=""

usage() {
    sed -n '2,14p' "$0"
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        -o) OUTPUT_FILE="$2"; shift 2 ;;
        -d) BUILD_DIR="$2"; shift 2 ;;
        -c) COMMENT="$2"; shift 2 ;;
        -C) CATEGORIES="$2"; shift 2 ;;
        -e) MAIN_EXEC="$2"; shift 2 ;;
        -t) APPIMAGE_TOOL="$2"; shift 2 ;;
        -h) usage ;;
        -*) echo "Unknown option: $1" >&2; usage ;;
        *) APP_NAME="$1"; shift ;;
    esac
done

if [ -z "$APP_NAME" ]; then
    echo "Error: No application name specified." >&2
    usage
fi

# Locate the application
if [ -d "$APP_NAME" ] && [ -f "$APP_NAME/GNUmakefile" ]; then
    APP_DIR="$APP_NAME"
elif [ -d "$APP_NAME.app" ]; then
    APP_DIR="$APP_NAME.app"
elif [ -d "$APP_NAME" ]; then
    APP_DIR="$APP_NAME"
else
    APP_DIR="$APP_NAME"
fi

APP_BASENAME=$(basename "$APP_NAME" .app)
BUILD_DIR="${BUILD_DIR:-/tmp/appimage-$APP_BASENAME}"
APPDIR="$BUILD_DIR/AppDir"
LIB_DIR="/usr/lib"
BIN_DIR="/usr/bin"

# Set up paths
rm -rf "$BUILD_DIR"
mkdir -p "$APPDIR$BIN_DIR" "$APPDIR$LIB_DIR"

# Build and install to AppDir
if [ -f "$APP_DIR/GNUmakefile" ]; then
    echo "Building $APP_NAME and installing to AppDir..."
    (cd "$APP_DIR" && make install DESTDIR="$APPDIR")
else
    echo "Error: Cannot find GNUmakefile for $APP_NAME" >&2
    exit 1
fi

# Copy GNUstep system tools
mkdir -p "$APPDIR/usr/local/bin"
for tool in gdnc gpbs make_services; do
    SYS_TOOL=$(gnustep-config --variable=GNUSTEP_SYSTEM_TOOLS 2>/dev/null)/$tool
    if [ -x "$SYS_TOOL" ]; then
        cp -p "$SYS_TOOL" "$APPDIR/usr/local/bin/" 2>/dev/null || true
    fi
done

# Create GNUstep config
mkdir -p "$APPDIR/usr/etc/GNUstep"
cat > "$APPDIR/usr/etc/GNUstep/GNUstep.conf" << 'CONFEOF'
GNUSTEP_USER_CONFIG_FILE=.GNUstep.conf
GNUSTEP_USER_DEFAULTS_DIR=GNUstep/Defaults
GNUSTEP_SYSTEM_USERS_DIR=/home
GNUSTEP_NETWORK_USERS_DIR=/home
GNUSTEP_LOCAL_USERS_DIR=/home
GNUSTEP_SYSTEM_LIBRARY=../../lib/GNUstep
GNUSTEP_LOCAL_LIBRARY=../../lib/GNUstep
GNUSTEP_NETWORK_LIBRARY=../../lib/GNUstep
GNUSTEP_SYSTEM_TOOLS=../../local/bin
GNUSTEP_LOCAL_TOOLS=../../local/bin
CONFEOF
chmod 600 "$APPDIR/usr/etc/GNUstep/GNUstep.conf"

# Bundle shared library dependencies
bundle_deps() {
    local file="$1"
    PREFIXES=$(gnustep-config --variable=GNUSTEP_LIBRARIES_DIRS 2>/dev/null || echo "/usr/local/lib")
    LDPATH=$(echo "$PREFIXES" | tr ' ' ':')
    LD_LIBRARY_PATH="$LDPATH:$LD_LIBRARY_PATH" ldd "$file" 2>/dev/null | grep "=>" | awk '{print $3}' | while read -r lib; do
        [ -z "$lib" ] && continue
        case "$lib" in
            */libc.so*|*/libpthread.so*|*/libdl.so*|*/libm.so*|*/librt.so*|*/libX11.so*|*/libXext.so*|*/libxcb.so*) continue ;;
            */ld-linux*) continue ;;
        esac
        dest="$APPDIR$LIB_DIR"
        mkdir -p "$dest"
        [ -f "$lib" ] && cp -L "$lib" "$dest/$(basename "$lib")" 2>/dev/null || true
    done
}

echo "Bundling shared library dependencies..."
for f in $(find "$APPDIR" -type f -executable); do
    bundle_deps "$f"
done

# Bundle GNUstep backends/bundles
for pref in $(gnustep-config --variable=GNUSTEP_LIBRARIES_DIRS 2>/dev/null || echo "/usr/local/lib"); do
    if [ -d "$pref/GNUstep/Bundles" ]; then
        mkdir -p "$APPDIR/usr/lib/GNUstep/Bundles"
        cp -Rp "$pref/GNUstep/Bundles/." "$APPDIR/usr/lib/GNUstep/Bundles/" 2>/dev/null || true
    fi
done

# Symlink backend bundle
BACKEND=$(find "$APPDIR/usr/lib/GNUstep/Bundles" -name "libgnustep-back-*.bundle" 2>/dev/null | head -n 1)
if [ -n "$BACKEND" ]; then
    ln -sf "$(basename "$BACKEND")" "$APPDIR/usr/lib/GNUstep/Bundles/libgnustep-back.bundle" 2>/dev/null || true
fi

# Bundle deps for bundles too
for lib in $(find "$APPDIR/usr/lib/GNUstep/Bundles" -type f -executable 2>/dev/null); do
    bundle_deps "$lib"
done

# Determine main executable
if [ -z "$MAIN_EXEC" ]; then
    MAIN_EXEC=$(find "$APPDIR" -type f -executable -name "$APP_BASENAME" 2>/dev/null | head -n 1)
    if [ -z "$MAIN_EXEC" ]; then
        MAIN_EXEC=$(find "$APPDIR" -path "*/lib*" -prune -o -type f -executable -print 2>/dev/null | head -n 1)
    fi
    if [ -z "$MAIN_EXEC" ]; then
        echo "Error: No executable found in AppDir" >&2
        exit 1
    fi
    MAIN_EXEC_REL="${MAIN_EXEC#$APPDIR}"
else
    MAIN_EXEC_REL="$MAIN_EXEC"
fi

# Create AppRun
cat > "$APPDIR/AppRun" << RUNEOF
#!/bin/sh
HERE="\$(dirname "\$(readlink -f "\${0}")")"
export GNUSTEP_PREFIX="\$HERE/usr"
export GNUSTEP_SYSTEM_ROOT="\$HERE/usr/system"
export GNUSTEP_LOCAL_ROOT="\$HERE/usr/local"
export GNUSTEP_NETWORK_ROOT="\$HERE/usr/network"
export GNUSTEP_CONFIG_FILE="\$HERE/usr/etc/GNUstep/GNUstep.conf"
export GNUSTEP_SYSTEM_LIBRARIES="\$HERE/usr/lib"
export GNUSTEP_LOCAL_LIBRARIES="\$HERE/usr/local/lib"
export LD_LIBRARY_PATH="\$HERE/usr/lib:\$HERE/usr/local/lib:\$LD_LIBRARY_PATH"
export PATH="\$HERE/usr/local/bin:\$HERE/usr/bin:\$PATH"
exec "\$HERE$MAIN_EXEC_REL" "\$@"
RUNEOF
chmod +x "$APPDIR/AppRun"

# Create .desktop file
ICON_NAME=""
APP_ICON=$(find "$APPDIR" -name "*.png" -o -name "*.svg" -o -name "*.xpm" 2>/dev/null | head -n 1)
if [ -n "$APP_ICON" ]; then
    cp "$APP_ICON" "$APPDIR/"
    ICON_NAME=$(basename "${APP_ICON%.*}")
fi

APP_VERSION=$(cd "$APP_DIR" 2>/dev/null && grep -s "^VERSION" GNUmakefile | head -n 1 | sed 's/.*=[ ]*//' || echo "1.0")
[ -z "$APP_VERSION" ] && APP_VERSION="1.0"

cat > "$APPDIR/$APP_BASENAME.desktop" << DESKTOPFEOF
[Desktop Entry]
Type=Application
Name=$APP_BASENAME
Comment=${COMMENT:-$APP_BASENAME application}
Exec=$MAIN_EXEC_REL
Icon=$ICON_NAME
Categories=${CATEGORIES:-Utility;}
Terminal=false
DESKTOPFEOF

# Package AppImage
ARCH=$(uname -m)
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
OUTPUT_FILE="${OUTPUT_FILE:-${APP_BASENAME}-${APP_VERSION}-${ARCH}-${OS}.AppImage}"

echo "Creating AppImage: $OUTPUT_FILE"
"$APPIMAGE_TOOL" "$APPDIR" "$OUTPUT_FILE"

echo "Done: $OUTPUT_FILE"
