GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
include $(GNUSTEP_MAKEFILES)/common.make

GNUSTEP_APPS = $(GNUSTEP_CORE_SERVICES_APPS)

PACKAGE_NAME = Menu
VERSION = 1.0
APP_NAME = Menu

# App info
Menu_APPLICATION_ICON = Menu.png
Menu_PRINCIPAL_CLASS = MenuApplication

# Source files
Menu_OBJC_FILES = \
	main.m \
	MenuApplication.m \
	MenuController.m \
	MenuBarView.m \
	CustomMenuPanel.m \
	AppMenuWidget.m \
	MenuProtocolManager.m \
	GNUStepMenuImporter.m \
	DBusMenuImporter.m \
	GTKMenuImporter.m \
	DBusMenuParser.m \
	GTKMenuParser.m \
	DBusMenuShortcutParser.m \
	GNUStepMenuActionHandler.m \
	DBusMenuActionHandler.m \
	GTKActionHandler.m \
	DBusSubmenuManager.m \
	GTKSubmenuManager.m \
	DBusConnection.m \
	MenuUtils.m \
	X11ShortcutManager.m \
	RoundedCornersView.m \
	ActionSearch.m \
	StatusItemManager.m \
	StatusItemsView.m \
	WindowMonitor.m \
	AppMenuImporter.m \
	StatusItems/TimeDisplay/TimeDisplayProvider.m \
	StatusItems/SystemMonitor/SystemMonitorProvider.m

# Header files
Menu_HEADER_FILES = \
	MenuApplication.h \
	MenuController.h \
	MenuBarView.h \
	CustomMenuPanel.h \
	AppMenuWidget.h \
	MenuProtocolManager.h \
	GNUStepMenuIPC.h \
	GNUStepMenuImporter.h \
	DBusMenuImporter.h \
	GTKMenuImporter.h \
	DBusMenuParser.h \
	GTKMenuParser.h \
	DBusMenuShortcutParser.h \
	GNUStepMenuActionHandler.h \
	DBusMenuActionHandler.h \
	GTKActionHandler.h \
	DBusSubmenuManager.h \
	GTKSubmenuManager.h \
	DBusConnection.h \
	MenuUtils.h \
	X11ShortcutManager.h \
	RoundedCornersView.h \
	ActionSearch.h \
	StatusItemProvider.h \
	StatusItemManager.h \
	StatusItemsView.h \
	WindowMonitor.h \
	AppMenuImporter.h

# Resources
Menu_RESOURCE_FILES = \
	Menu.png \
	Info.plist


# Libraries and frameworks - configured by configure script
Menu_TOOL_LIBS += @DBUS_LIBS@ -lX11
Menu_GUI_LIBS += -L/System/Library/Libraries -lgnustep-gui -lgnustep-base -lobjc -ldispatch
Menu_LDFLAGS += -Wl,--export-dynamic -L/System/Library/Libraries -Wl,-rpath,/System/Library/Libraries -Wl,--no-as-needed

# Compiler flags - Force use of /System GNUstep and objc2 with ARC

# Platform-specific flags for Linux and BSD - configured by configure script
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
	ADDITIONAL_OBJCFLAGS = -Wall -Wextra -O2 -fobjc-runtime=gnustep-2.0 -fobjc-arc -Wno-unused-parameter -D_GNU_SOURCE
	ADDITIONAL_CPPFLAGS = @DBUS_CFLAGS@
endif
ifeq ($(UNAME_S),FreeBSD)
	ADDITIONAL_OBJCFLAGS = -Wall -Wextra -O2 -fobjc-runtime=gnustep-2.0 -fobjc-arc -Wno-unused-parameter -D_BSD_SOURCE
	ADDITIONAL_CPPFLAGS = @DBUS_CFLAGS@
endif

include $(GNUSTEP_MAKEFILES)/application.make

after-install::
	@echo "Building and installing status item bundles..."
	@(cd StatusItems/SystemMonitor && GNUSTEP_MAKEFILES=$(GNUSTEP_MAKEFILES) $(MAKE) all)
	@(cd StatusItems/TimeDisplay && GNUSTEP_MAKEFILES=$(GNUSTEP_MAKEFILES) $(MAKE) all)
	@if [ -n "$(DESTDIR)" ]; then \
		mkdir -p $(DESTDIR)$(GNUSTEP_SYSTEM_LIBRARY)/Menu/StatusItems; \
		cp -R StatusItems/SystemMonitor/SystemMonitor.bundle $(DESTDIR)$(GNUSTEP_SYSTEM_LIBRARY)/Menu/StatusItems/ || true; \
		cp -R StatusItems/TimeDisplay/TimeDisplay.bundle $(DESTDIR)$(GNUSTEP_SYSTEM_LIBRARY)/Menu/StatusItems/ || true; \
	else \
		mkdir -p $(GNUSTEP_SYSTEM_LIBRARY)/Menu/StatusItems; \
		cp -R StatusItems/SystemMonitor/SystemMonitor.bundle $(GNUSTEP_SYSTEM_LIBRARY)/Menu/StatusItems/ || true; \
		cp -R StatusItems/TimeDisplay/TimeDisplay.bundle $(GNUSTEP_SYSTEM_LIBRARY)/Menu/StatusItems/ || true; \
	fi
