#!/usr/bin/env run_uitest
# SystemProfiler: the system information tool must start, show its window and
# its main menu, then quit with the standard Cmd+Q shortcut.
#
# Leaves the computer as it was found: the app is quit at the end.
#
# Run with: run_uitest SystemProfiler/Tests/system_profiler.uitest
launch application "SystemProfiler"
wait until window "System Profiler" timeout 15s
assert window "System Profiler"
assert menu item "SystemProfiler/About SystemProfiler..." exists
assert menu item "SystemProfiler/Hide SystemProfiler" exists
assert menu item "SystemProfiler/Quit SystemProfiler" shortcut "Cmd+Q"
assert menu item "Edit/Copy" shortcut "Cmd+C"
assert menu item "Edit/Copy" shortcut "Cmd+C"
activate application "SystemProfiler"
wait until menu bar "SystemProfiler" timeout 10s
press "Alt+Q"
wait until not exists window "System Profiler" timeout 5s
assert not exists application "SystemProfiler"
log "SystemProfiler starts, shows its menu and quits"
