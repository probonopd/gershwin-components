#!/usr/bin/env run_uitest
# Processes: the process monitor must start, show its window and its main
# menu, then quit with the standard Cmd+Q shortcut.
#
# Leaves the computer as it was found: the app is quit at the end.
#
# Run with: run_uitest Processes/Tests/processes.uitest
launch application "Processes"
wait until window "Processes" timeout 15s
assert window "Processes"
assert menu item "Processes/About Processes" exists
assert menu item "Processes/Hide Processes" exists
assert menu item "Processes/Quit Processes" shortcut "Cmd+Q"
assert menu item "Window/Minimize" shortcut "Cmd+M"
activate application "Processes"
wait until menu bar "Processes" timeout 10s
press "Alt+Q"
wait until not exists window "Processes" timeout 5s
assert not exists application "Processes"
log "Processes starts, shows its menu and quits"
