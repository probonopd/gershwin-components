include $(GNUSTEP_MAKEFILES)/common.make

GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
GNUSTEP_APPS = $(GNUSTEP_SYSTEM_CORE_SERVICES)

APP_NAME = SudoAskPass
SudoAskPass_OBJC_FILES = SudoAskPass.m
SudoAskPass_RESOURCE_FILES =

include $(GNUSTEP_MAKEFILES)/application.make

after-install::
	@if [ -n "$(DESTDIR)" ]; then \
		mkdir -p $(DESTDIR)$(GNUSTEP_SYSTEM_TOOLS); \
		ln -sf $(GNUSTEP_SYSTEM_CORE_SERVICES)/$(APP_NAME).app/$(APP_NAME) $(DESTDIR)$(GNUSTEP_SYSTEM_TOOLS)/$(APP_NAME); \
	else \
		mkdir -p $(GNUSTEP_SYSTEM_TOOLS); \
		ln -sf $(GNUSTEP_SYSTEM_CORE_SERVICES)/$(APP_NAME).app/$(APP_NAME) $(GNUSTEP_SYSTEM_TOOLS)/$(APP_NAME); \
	fi
