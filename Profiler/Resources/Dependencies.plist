<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="0.9">
<dict>
    <key>packages</key>
    <array>
        <string>linux-perf</string>
        <string>linux-heaptrack</string>
    </array>
    <key>os_overrides</key>
    <dict>
        <key>linux</key>
        <dict>
            <key>description</key>
            <string>CPU profiler using hardware performance counters</string>
        </dict>
        <key>freebsd</key>
        <dict>
            <key>description</key>
            <string>Use procstat and pmcstat instead of perf on FreeBSD</string>
        </dict>
        <key>openbsd</key>
        <dict>
            <key>description</key>
            <string>Use native OpenBSD profiling tools instead of perf</string>
        </dict>
        <key>netbsd</key>
        <dict>
            <key>description</key>
            <string>Use native NetBSD profiling tools instead of perf</string>
        </dict>
    </dict>
</dict>
</plist>
