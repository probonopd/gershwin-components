#!/usr/bin/env run_uitest
# Whisper: the speech-to-text app must start, show its window and its record
# controls, then quit with the standard Cmd+Q shortcut.
#
# Leaves the computer as it was found: the app is quit at the end.
#
# Run with: run_uitest Whisper/Tests/whisper.uitest
launch application "Whisper"
wait until window "Whisper Speech-to-Text" timeout 5s
assert window "Whisper Speech-to-Text"
assert button "Record"
assert button "Stop"
assert text contains "Ready"
assert button "Copy to Clipboard"
assert menu item "Whisper/Quit Whisper" shortcut "Cmd+Q"
assert menu item "Whisper/Transcribe file..." shortcut "Cmd+O"
assert menu item "Edit/Cut" shortcut "Cmd+X"
press "Cmd+Q"
wait until not exists window "Whisper Speech-to-Text" timeout 5s
log "Whisper starts, shows its controls and quits"
