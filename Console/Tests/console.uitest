#!/usr/bin/env run_uitest
# Console: the system log viewer must start, show its window and its main
# menu, then quit with the standard Cmd+Q shortcut.
#
# Leaves the computer as it was found: the app is quit at the end.
#
# Run with: run_uitest Console/Tests/console.uitest
launch application "Console"
wait until window "Console" timeout 90s
assert window "Console"
assert menu item "Console/About Console" exists
assert menu item "Console/Quit Console" exists
assert menu item "Console/Quit Console" shortcut "Cmd+Q"
assert menu item "File/New System Log Query" shortcut "Cmd+N"
assert menu item "Edit/Copy" shortcut "Cmd+C"
activate application "Console"
wait until menu bar "Console" timeout 10s
press "Alt+Q"
wait until not exists window "Console" timeout 5s
assert not exists application "Console"
log "Console starts, shows its menu and quits"
